#!/bin/sh

level_prefix=$(printf "%s\n" "$USER" | sed 's/[0-9]//g')
level_number=$(printf "%s\n" "$USER" | sed 's/[^0-9]//g')

if [ -z "$level_number" ]; then
    echo "Could not determine the current level."
    exit 1
fi

if [ "$level_number" -le 1 ]; then
    echo "You are already at the lowest level."
    exit 0
fi

su - "$level_prefix$(expr "$level_number" - 1)"
