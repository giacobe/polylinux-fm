#!/bin/sh

state_hash() {
    target_dir="$1"

    (
        cd "$target_dir" || exit 1
        find . ! -name ".ash_history" -exec ls -ld {} \; |
        grep -v '\.ash_history' |
        awk '{
            item_mode = $1
            item_owner = $3
            item_group = $4
            item_size = $5
            item_name = $9
            for (i = 10; i <= NF; i++) {
                item_name = item_name " " $i
            }
            if (substr(item_mode, 1, 1) == "d") {
                item_size = 0
            }
            print item_mode, item_owner, item_group, item_size, item_name
        }' |
        sed 's# \./# #' |
        sort |
        sha256sum |
        awk '{print $1}' |
        base64 |
        tr -d '\n' |
        cut -c 1-10
    )
}

level_home="/home/$USER"
if [ ! -d "$level_home" ]; then
    echo "No level home was found for $USER."
    exit 1
fi

actual_hash=$(state_hash "$level_home")
echo "Your key is: $actual_hash"
exit 0
